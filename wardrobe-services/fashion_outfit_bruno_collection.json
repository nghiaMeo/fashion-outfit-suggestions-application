                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"test@gmail.com\",\n  \"username\": \"testuser\",\n  \"displayName\": \"Test User Display\",\n  \"password\": \"Test@1234\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/api/auth/register",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "auth", "register"]
                },
                "description": "Đăng ký tài khoản mới. Cần điền đầy đủ email, username, displayName và password."
